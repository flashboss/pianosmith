# Local settings for `npm run cookies:export -- remote`
# Copy to `.env` (gitignored) and fill in.

# Google Cloud project that owns the Secret Manager secret
GCLOUD_PROJECT=your-gcp-project-id

# Secret id in Secret Manager (must already exist)
GCLOUD_SECRET_YTDLP_COOKIES_B64=YTDLP_COOKIES_B64

# Optional: printed as a hint after upload (does not auto-redeploy)
GCLOUD_RUN_SERVICE=your-cloud-run-service
GCLOUD_RUN_REGION=europe-west1
