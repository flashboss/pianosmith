# Local settings for `npm run cookies:export -- remote`
# Copy to `.env` (gitignored). Requires Railway CLI (`railway login` + `railway link`)
# or RAILWAY_TOKEN in the environment.

# Service that receives YTDLP_COOKIES_B64 (Railway Variables — not a volume)
RAILWAY_SERVICE=your-railway-service-name

# Optional
# RAILWAY_ENVIRONMENT=production
# RAILWAY_PROJECT_ID=your-project-id
# RAILWAY_VARIABLE_YTDLP_COOKIES_B64=YTDLP_COOKIES_B64
# RAILWAY_HEALTH_URL=https://your-service.up.railway.app/api/health
# Skip the post-upload redeploy (variable is still set + verified first)
# RAILWAY_SKIP_DEPLOYS=1
