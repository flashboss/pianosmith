{
  "name": "pianosmith",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-model.mjs",
    "dev": "node server/index.mjs",
    "build": "vite build && node scripts/stage-tizen.mjs",
    "start": "NODE_ENV=production node server/index.mjs",
    "cookies:export": "node scripts/export-yt-cookies.mjs",
    "typecheck": "tsc --noEmit",
    "android:add": "npm run build && npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@spotify/basic-pitch": "1.0.1",
    "@tensorflow/tfjs": "3.21.0",
    "@tonejs/midi": "^2.0.28",
    "jspdf": "^4.2.1",
    "vexflow": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@types/jspdf": "^1.3.3",
    "typescript": "^5.6.3",
    "vite": "^6.0.7"
  }
}
